# Copie para .env e preencha. Nunca versione o .env.
OPENAI_API_KEY=
# Modelo do LLM (escolhido no Dia 1; troque aqui sem mexer no código)
OPENAI_MODEL=gpt-5.4-mini
# local | openai
EMBEDDINGS=local
# Material usado na análise. O padrão é o fictício; aponte para data/private só localmente.
MATERIAL_DIR=data/sample

# Opcional: preços do seu modelo (US$ por 1 milhão de tokens) para estimar o custo de cada análise.
# Consulte a página de preços da OpenAI. Em branco = mostra só os tokens.
PRICE_IN_PER_1M=
PRICE_OUT_PER_1M=
